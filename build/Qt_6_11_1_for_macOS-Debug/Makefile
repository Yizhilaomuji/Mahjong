####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/Mahjong/bin || mkdir -p $(INSTALL_ROOT)/opt/Mahjong/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/Mahjong/bin/Mahjong.app
	
	$(QINSTALL) Mahjong.app $(INSTALL_ROOT)/opt/Mahjong/bin/Mahjong.app

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/Mahjong/bin/Mahjong.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/Mahjong/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

.SUFFIXES:

