Mahjong.app/Contents/PkgInfo: 
	@test -d Mahjong.app/Contents || mkdir -p Mahjong.app/Contents
	@$(DEL_FILE) Mahjong.app/Contents/PkgInfo
	@echo "APPL????" > Mahjong.app/Contents/PkgInfo
Mahjong.app/Contents/Info.plist: 
	@test -d Mahjong.app/Contents || mkdir -p Mahjong.app/Contents
	@$(DEL_FILE) Mahjong.app/Contents/Info.plist
	@set -o pipefail && plutil -convert xml1 -o - ../../../../Qt/6.11.1/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.Mahjong,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.Mahjong,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,MahjongIcon.icns,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},MahjongIcon.icns,g" -e "s,@EXECUTABLE@,Mahjong,g" -e "s,@LIBRARY@,Mahjong,g" -e "s,\$${EXECUTABLE_NAME},Mahjong,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >Mahjong.app/Contents/Info.plist
